# Optional backend (maintained separately — not part of the static site)
backend/

# Tooling / agent workspaces
.kerno/
.agents/

# Dependencies & env
node_modules/
.env
.env.*

# Build output — there is no bundler by design (the site serves plain
# files), but keep the usual folders ignored so an experiment with one
# can never leak half-built output into the repo.
dist/
build/
.vite/

# Dev scratch files
__*.js
out.txt
test-results.txt

# Local-only heavy media: the raw hero-loop source stays on the machine it
# was trimmed on — the repo ships the compressed images/hero-bg.mp4 only.
images/*.source.mp4

# Logs & OS junk
*.log
.DS_Store
Thumbs.db

